# ══════════════════════════════════════════════════════════════════════════════
# RootIQ RAG — Environment Configuration
# Copy this file to .env and fill in your real keys.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Single LLM Configuration ──────────────────────────────────────────────────
# Supported providers: gemini, openrouter, openai, anthropic
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
GEMINI_API_KEY=your-gemini-api-key-here

# Alternately, for OpenRouter/OpenAI-compatible APIs:
# LLM_PROVIDER=openrouter
# LLM_MODEL=deepseek/deepseek-chat:free
# LLM_API_KEY=your-openrouter-api-key-here
# LLM_API_BASE=https://openrouter.ai/api/v1/chat/completions

# ── Embeddings Configuration ──────────────────────────────────────────────────
# Default local free model: BAAI/bge-small-en-v1.5
EMBED_MODEL=BAAI/bge-small-en-v1.5

# ── ChromaDB (persistent vector store) ────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION=rootiq_knowledge

# ── Chunking Parameters ───────────────────────────────────────────────────────
# Measured in real BPE tokens
CHUNK_SIZE=250
CHUNK_OVERLAP=50

# ── Pipeline Control ──────────────────────────────────────────────────────────
# Set to "true" to call the real Generation LLM; "false" uses offline template.
USE_REAL_LLM=true
